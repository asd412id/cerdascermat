# Worker (Cloudflare) — isi lewat `wrangler secret put`, jangan commit nilai asli.
# Owner diseed otomatis saat PlatformDO pertama kali dipakai.
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-dengan-sandi-kuat-minimal-10-karakter
ALLOW_ADMIN_SIGNUP=false

# Dipisah koma, tanpa spasi. Wajib memuat origin SPA yang boleh memanggil API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://cerdas-cermat-2026.web.app,https://cerdas-cermat-2026.firebaseapp.com
SESSION_TTL_HOURS=12
LEAD_MS=900
DECISION_MS=220
TIE_MS=15
READY_MAX_U_MS=150

# Web (Vite) — origin Worker tanpa garis miring di akhir.
# Produksi: https://cerdascermat-api.asdar-binsyam.workers.dev
VITE_API_BASE=http://localhost:8787
